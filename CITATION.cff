    given-names: Jared E.
    orcid: "https://orcid.org/0000-0002-1546-4030"
version: 1.1.0
# the concept DOI: resolves to the latest release; each release also gets its own
doi: 10.5281/zenodo.20385964
identifiers:
  - type: doi
    value: 10.5281/zenodo.20385964
    description: All versions of PyCLM (Zenodo concept DOI)
license: MIT
repository-code: "https://github.com/Harrison-Oatman/PyCLM"
url: "https://pyclm.readthedocs.io"
abstract: >-
  PyCLM runs many simultaneous closed-loop optogenetic experiments on a
  Micro-Manager microscope with a DMD: imaging, segmentation, tracking and
  light-pattern generation in parallel, configured by TOML files and
  extensible with Python pattern, segmentation and tracking methods.
keywords:
  - microscopy
  - optogenetics
  - closed-loop control
  - smart microscopy
  - Micro-Manager
preferred-citation:
  type: article
  title: >-
    An optogenetic smart microscopy platform reveals signaling
    dynamics-dependent control over collective cell migration
